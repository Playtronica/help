# Playtronica help-center environment variables.
# Copy this file to `.env.local` for local dev. Set the same vars in Cloudflare
# Pages → Settings → Environment Variables for production.
#
# All vars are PUBLIC (NEXT_PUBLIC_*) — they ship to the browser. Tracker IDs
# are public anyway; do NOT put secrets (API keys, tokens that grant write
# access) here.
#
# Every variable is OPTIONAL. If it is missing, the matching tracker is a no-op.

# Google Analytics 4 measurement ID (looks like "G-XXXXXXXXXX")
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity project ID (the alphanumeric slug, not a URL)
NEXT_PUBLIC_CLARITY_ID=

# Cloudflare Web Analytics site token (long base64-ish string from CF dashboard)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
