# Normalise line endings on commit; check out using the platform's native LF.
* text=auto eol=lf

# Binary files — never converted, never diffed line-by-line.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.svg    text
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.zip    binary
*.gz     binary

# Generated files — collapsed in diffs.
public/search-index.json linguist-generated=true
public/llms.txt          linguist-generated=true
public/llms-full.txt     linguist-generated=true
public/sitemap.xml       linguist-generated=true
package-lock.json        linguist-generated=true

# Mark documentation as docs in language stats.
content/**/*.md          linguist-documentation=true
docs/**/*.md             linguist-documentation=true
